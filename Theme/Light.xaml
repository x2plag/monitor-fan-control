    <SolidColorBrush x:Key="SurfaceRaised" Color="#EDF2F8" />
    <SolidColorBrush x:Key="Accent" Color="#1767AA" />
    <SolidColorBrush x:Key="Muted" Color="#536478" />
    <SolidColorBrush x:Key="Text" Color="#1C2735" />
