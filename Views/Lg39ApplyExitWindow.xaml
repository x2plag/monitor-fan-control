<Window x:Class="MonitorFanControl.Lg39ApplyExitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LG 39GX950B — применить и выйти" Width="590" Height="460"
        MinWidth="520" MinHeight="440" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Canvas}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14" Closing="Window_Closing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="26">
        <TextBlock Text="Тихий режим — применить и выйти" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="LG UltraGear 39GX950B" Foreground="{DynamicResource Muted}" Margin="0,5,0,20" />
        <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="18">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Готов к применению" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Text="Нажми «Применить и выйти». После успеха все процессы завершатся без возврата автоматики."
                           Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" />
                <ProgressBar x:Name="BusyProgress" Height="3" Margin="0,14,0,0" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <Button x:Name="ApplyButton" Content="Применить и выйти" Click="ApplyButton_Click"
                AutomationProperties.AutomationId="ApplyExitButton" Padding="18,12" Margin="0,18,0,0"
                Background="{DynamicResource Accent}" Foreground="{DynamicResource Canvas}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Экспериментальный режим. Свежие обороты и температура не измеряются."
                   TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>
