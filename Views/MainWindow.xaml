<Window x:Class="MonitorFanControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitor Fan Control" Height="440" Width="485"
        MinHeight="440" MinWidth="485" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" Background="{DynamicResource Canvas}"
        Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        IsVisibleChanged="Window_IsVisibleChanged" SourceInitialized="Window_SourceInitialized"
        Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="MONITOR FAN CONTROL" Foreground="{DynamicResource Accent}"
                           FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="DetectedModelText" Text="Detecting display…"
                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0">
                    <ToolTipService.ToolTip>
                        <ToolTip>
                            <TextBlock Text="Model family is looked up from Windows' monitor hardware ID when known; retail revisions may differ, and Windows does not link it uniquely to the USB fan controller."
                                       Foreground="{DynamicResource Text}"
                                       Background="{DynamicResource SurfaceRaised}"
                                       TextWrapping="Wrap" MaxWidth="360" />
                        </ToolTip>
                    </ToolTipService.ToolTip>
                </TextBlock>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource Surface}" CornerRadius="16"
                    Padding="10,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="{DynamicResource Muted}"
                             VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock x:Name="ConnectionLabel" Text="Starting…" FontSize="11"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="12"
                Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TARGET" Foreground="{DynamicResource Muted}"
                                   FontSize="10" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SelectedValue" Text="—" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="%" FontSize="15" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Bottom" Margin="3,0,0,5" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                        <TextBlock Text="LIVE" Foreground="{DynamicResource Muted}"
                                   FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="CurrentValue" Text="—" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock Text="%" FontSize="12" Foreground="{DynamicResource Muted}"
                                       VerticalAlignment="Bottom" Margin="3,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusDetail" Text="Waiting for controller readback…"
                           Foreground="{DynamicResource Muted}" FontSize="11" MinHeight="16" />
                <Slider x:Name="DutySlider" Style="{DynamicResource FanDutySlider}"
                        Minimum="25" Maximum="100" Value="25"
                        TickFrequency="1" IsSnapToTickEnabled="True" IsMoveToPointEnabled="True"
                        Margin="0,7,0,3" LargeChange="1" SmallChange="1"
                        ValueChanged="DutySlider_ValueChanged"
                        PreviewMouseLeftButtonUp="DutySlider_PreviewMouseLeftButtonUp"
                        KeyUp="DutySlider_KeyUp" />
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="25%" Foreground="{DynamicResource Muted}" FontSize="10" />
                    <TextBlock Grid.Column="1" Text="62%" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Center" FontSize="10" />
                    <TextBlock Grid.Column="2" Text="100%" Foreground="{DynamicResource Muted}"
                               HorizontalAlignment="Right" FontSize="10" />
                </Grid>
                <Grid Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="KeepTargetCheckBox" Content="Keep this target applied automatically"
                              Style="{DynamicResource ModernCheckBox}" VerticalAlignment="Center"
                              Click="KeepTargetCheckBox_Click" />
                    <!-- Hidden rather than collapsed, so toggling the checkbox does not shift the layout. -->
                    <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply"
                            Style="{DynamicResource ModernButton}" Margin="12,0,0,0"
                            VerticalAlignment="Center" Visibility="Hidden"
                            ToolTip="Send the target to the monitor again."
                            Click="ApplyButton_Click" />
                </Grid>
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start with Windows, hidden in the tray"
                          Style="{DynamicResource ModernCheckBox}"
                          Click="StartWithWindowsCheckBox_Click" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2">
            <TextBlock Foreground="{DynamicResource Muted}" FontSize="10">
                <Run Text="Reads every second while this window is open and every 10 seconds in the tray." />
                <LineBreak />
                <Run Text="Repeated corrections are limited to once every 10 seconds." />
            </TextBlock>
            <TextBlock Text="Only the 32GS95UV-B has been hardware-tested; other matching models remain unverified."
                       Foreground="{DynamicResource Warning}" FontSize="10" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</Window>
